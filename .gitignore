# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments
.venv/
venv/
.pnpm-store/

# Secrets and machine-specific configuration
.env
.env.*
!.env.example

# Database exports can contain private data. The reviewed paper evidence is
# deliberately versioned for reproducibility.
*.csv
!evidence/**/*.csv

# Local durable Revon repositories
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Test-generated fixtures (retain the directory itself)
test_data/*
!test_data/.gitkeep

# Generated working, rendering, and local review files
tmp/
tmp*/
/output/
/local_artifacts/

# Local-only preparation and review material
/Revon_Current_Stage_Presentation_Guide.pdf
/Paper Basics.pdf
/Research Abstract Review 1.pdf
/docs/commits/2026-08-25-supporting-submission-materials.md
/docs/commits/2026-08-25-viva-question-bank.md
/tools/build_revon_viva_questions.py
/tools/build_daily_summary_pdf.py
/tools/build_research_paper.py

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*.docx
