    "source-map-js": "1.2.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "vinext": {
      "@vercel/og": "1.0.3"
    },
    "satori": {
      "fflate": "0.7.5"
    },
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
